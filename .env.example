# --- Kredensial SPADA UPN ---
SPADA_USERNAME=ganti_dengan_nim_atau_username
SPADA_PASSWORD=ganti_dengan_password

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=-1001234567890

# --- Browser ---
# true  = headless (default, untuk cron)
# false = tampilkan jendela browser (untuk debug)
HEADLESS_MODE=true

# Coma-separated: bisa berupa cmid saja atau URL penuh attendance module.
# Contoh: 12345,https://spada.upnyk.ac.id/mod/attendance/view.php?id=67890
SPADA_ATTENDANCE_URLS=12345

# Nama mata kuliah yang diabaikan (coma-separated, case-insensitive, substring match)
SKIP_COURSES=Kuliah Praktikum

# Umur timeout tiap langkah dalam milidetik
STEP_TIMEOUT_MS=20000

# Nama file user agent (kosongkan untuk memakai default Chromium)
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36

# Base URL Telegram Bot API (opsional, hanya untuk pengujian)
TELEGRAM_API_BASE=https://api.telegram.org

# Lokasi screenshot debugging saat gagal
ARTIFACT_DIR=artifacts
